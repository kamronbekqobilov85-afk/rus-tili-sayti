// Ma'lumotlar bazasi sxemasi: foydalanuvchilar (Google orqali kirish) va tashriflar statistikasi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel'dagi Neon integratsiyasi ulanganda avtomatik qo'shiladigan nomlar
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- NextAuth uchun standart jadvallar ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  // Gamifikatsiya: ball, kunlik maqsad, taklif tizimi
  xp           Int     @default(0)
  dailyGoal    Int     @default(20)
  referralCode String? @unique
  referredBy   String?

  accounts     Account[]
  sessions     Session[]
  visits       Visit[]
  dailyStats   DailyStat[]
  achievements UserAchievement[]
  feedbacks    Feedback[]
}

// Foydalanuvchilar yuborgan savol/taklif/fikrlar
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  message   String   @db.Text
  status    String   @default("new") // "new" | "read" | "resolved"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
}

// Kunlik to'plangan ball — kunlik maqsad va reyting uchun
model DailyStat {
  id     String @id @default(cuid())
  userId String
  date   String // "YYYY-MM-DD"
  xp     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// Ochilgan yutuqlar (badge'lar)
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tashriflar statistikasi (kim, qachon, qaysi qurilmadan) ---

model Visit {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  device    String // "mobile" | "tablet" | "desktop"
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
