// Ma'lumotlar bazasi sxemasi: foydalanuvchilar (Google orqali kirish) va tashriflar statistikasi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel'dagi Neon integratsiyasi ulanganda avtomatik qo'shiladigan nomlar
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- NextAuth uchun standart jadvallar ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  // Gamifikatsiya: ball, kunlik maqsad, taklif tizimi
  xp           Int     @default(0)
  dailyGoal    Int     @default(20)
  referralCode String? @unique
  referredBy   String?
  groupId      String?

  accounts     Account[]
  sessions     Session[]
  visits       Visit[]
  dailyStats   DailyStat[]
  achievements UserAchievement[]
  feedbacks         Feedback[]
  dailyChallenges   DailyChallenge[]
  dailyChests       DailyChest[]
  voiceRecordings   VoiceRecording[]
  pushSubscriptions PushSubscription[]
  telegramLink      TelegramLink?
  group             Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

// Brauzer push-bildirishnomasi uchun obuna (Web Push)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Telegram kanalga obuna bo'lganlik tasdiqlanganda +500 ball berish uchun
model TelegramLink {
  id            String    @id @default(cuid())
  userId        String    @unique
  linkCode      String    @unique
  telegramId    String?   @unique
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Foydalanuvchi talaffuz mashqida yozib yuborgan ovoz — faqat admin eshita oladi
model VoiceRecording {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  phraseRu  String
  audioUrl  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Foydalanuvchilar o'zaro tuzadigan kichik guruh (jamoa reytingi uchun)
model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  members User[]
}

// Kunlik mini-mashqni bajarganlik belgisi (bonus ball bir marta beriladi)
model DailyChallenge {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Sirli sandiq: kuniga bir marta ochiladi, ichidan tasodifiy ball chiqadi
model DailyChest {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD" (Toshkent vaqti bo'yicha)
  reward    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Foydalanuvchilar yuborgan savol/taklif/fikrlar
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  message   String   @db.Text
  status    String   @default("new") // "new" | "read" | "resolved"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
}

// Kunlik to'plangan ball — kunlik maqsad va reyting uchun
model DailyStat {
  id         String @id @default(cuid())
  userId     String
  date       String // "YYYY-MM-DD"
  xp         Int    @default(0)
  referralXp Int    @default(0) // Haftalik Challenge: faqat do'st taklif qilib olingan ball

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// Ochilgan yutuqlar (badge'lar)
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tashriflar statistikasi (kim, qachon, qaysi qurilmadan) ---

model Visit {
  id        String   @id @default(cuid())
  userId    String?
  path      String
  device    String // "mobile" | "tablet" | "desktop"
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
