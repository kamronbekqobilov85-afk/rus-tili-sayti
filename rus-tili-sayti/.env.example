# Ma'lumotlar bazasi (Vercel'da Neon integratsiyasi ulanganda avtomatik qo'shiladi)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Google Cloud Console > APIs & Services > Credentials bo'limidan olinadi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `npx auth secret` yoki `openssl rand -base64 32` bilan hosil qilinadi
AUTH_SECRET=

# Admin bo'ladigan Google hisob emaili (shu email bilan kirgan kishi avtomatik admin bo'ladi)
ADMIN_EMAIL=

# Eslatma email'lari uchun resend.com'dan olinadigan API kalit (ixtiyoriy — bo'lmasa email jim o'chirilgan bo'ladi)
RESEND_API_KEY=

# Vercel Cron'ni tashqaridan chaqirib bo'lmasligi uchun maxfiy kalit (ixtiyoriy, istalgan uzun tasodifiy matn)
CRON_SECRET=

# Gapirish mashqidagi ovozli yozuvlarni saqlash uchun (Vercel'da Storage > Blob yaratilganda avtomatik qo'shiladi)
BLOB_READ_WRITE_TOKEN=

# Push-bildirishnomalar uchun (`npx web-push generate-vapid-keys` bilan hosil qilinadi)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram kanalga obunani tasdiqlab +500 ball berish uchun (@BotFather'dan olinadi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rustili24soat_bot
TELEGRAM_CHANNEL_USERNAME=@rustili24soat
# Webhook'ni tashqaridan chaqirib bo'lmasligi uchun maxfiy kalit (istalgan uzun tasodifiy matn)
TELEGRAM_WEBHOOK_SECRET=
