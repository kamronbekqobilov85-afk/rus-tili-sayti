# Ma'lumotlar bazasi (Vercel'da Neon integratsiyasi ulanganda avtomatik qo'shiladi)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Google Cloud Console > APIs & Services > Credentials bo'limidan olinadi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `npx auth secret` yoki `openssl rand -base64 32` bilan hosil qilinadi
AUTH_SECRET=

# Admin bo'ladigan Google hisob emaili (shu email bilan kirgan kishi avtomatik admin bo'ladi)
ADMIN_EMAIL=

# Eslatma email'lari uchun resend.com'dan olinadigan API kalit (ixtiyoriy — bo'lmasa email jim o'chirilgan bo'ladi)
RESEND_API_KEY=

# Vercel Cron'ni tashqaridan chaqirib bo'lmasligi uchun maxfiy kalit (ixtiyoriy, istalgan uzun tasodifiy matn)
CRON_SECRET=
